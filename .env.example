# Copy to contracts/.env (gitignored) and fill in. NEVER commit .env, never paste it anywhere.
# The deploy scripts only ever read keys from the environment / this file; they never print or write them.

# Funded Arc Testnet account (chain id 5042002) that deploys and owns everything. Gas is paid in USDC.
# Get testnet USDC from https://faucet.circle.com (select Arc Testnet). Needs roughly 20+ USDC:
# ~1-2 for gas, the rest becomes TSLA/USDC liquidity.
DEPLOYER_PRIVATE_KEY=0x...

# OPTIONAL separate liquidity providers (wide / medium / tight range). Each needs its own faucet USDC.
# Any left empty falls back to the deployer account playing that role.
LP1_PRIVATE_KEY=
LP2_PRIVATE_KEY=
LP3_PRIVATE_KEY=
# OPTIONAL accounts used by the demo/sim agents (addresses go into the manifest). Empty = deployer.
ARB_PRIVATE_KEY=
RETAIL_PRIVATE_KEY=

# OPTIONAL: RPC override (the public RPC rate-limits with HTTP 429; the scripts use --slow and retry).
# Alternatives: https://docs.arc.network/arc/references/rpc-endpoints
# ARC_RPC_URL=https://rpc.testnet.arc.network

# ---- liquidity sizing (USDC micro-units, 6 decimals; 1000000 = 1 USDC). Per LP, per pool (hook + control). ----
# Each LP spends LP_*_USDC_E6 of USDC on the quote side and about the same value of TSLA (minted through the
# issuer, which costs USDC too), in EACH of the two pools. Defaults ~ 4.2 USDC per LP, ~12.6 USDC total.
LP_WIDE_USDC_E6=1000000
LP_MEDIUM_USDC_E6=1000000
LP_TIGHT_USDC_E6=1000000
# USDC the deployer adds to the issuer's reserve buffer (covers a rising price on redeem). 0 = none.
FUND_RESERVE_USDC_E6=0
# USDC each of ARB / RETAIL spends minting TSLA for demo trading. 0 = skip.
ARB_USDC_E6=0
RETAIL_USDC_E6=0
